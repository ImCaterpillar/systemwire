# SYSTEMWIRE 演示站点环境变量示例
# 复制为 .env.local 后按需填写：cp .env.example .env.local
#
# 全部变量都是可选的。一个都不填时，大模型走内置「演示脚本」引擎，
# 完全离线 100% 可复现（见 README「DeepSeek 配置」）。

# ---- 主演示页（/）：DeepSeek 真实模型（左下角 LLM ENGINE 切到「DeepSeek」才生效）----
# 请求失败（断网 / Key 失效 / 超时）会自动回退演示脚本，演示永不中断。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 辅助演示路由（/single、/mcp-apps）：多模态模型选择 ----
# 三个都为空时回退到 openai/gpt-5-mini（辅助路由使用，不影响主演示页）。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---- 可选：覆盖前端调用的 CopilotKit Runtime 地址，默认 /api/copilotkit ----
NEXT_PUBLIC_COPILOTKIT_RUNTIME_URL=
